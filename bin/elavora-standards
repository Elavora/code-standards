#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function (): void {
    $candidates = [
        $GLOBALS['_composer_autoload_path'] ?? null,
        __DIR__ . '/../../../autoload.php',
        __DIR__ . '/../vendor/autoload.php',
    ];

    foreach ($candidates as $candidate) {
        if (\is_string($candidate) && is_file($candidate)) {
            require $candidate;

            $argv = $_SERVER['argv'] ?? [];
            $args = [];
            foreach (\is_array($argv) ? \array_slice($argv, 1) : [] as $arg) {
                if (\is_string($arg)) {
                    $args[] = $arg;
                }
            }

            exit(Elavora\CodeStandards\Cli::main($args, STDOUT, STDERR));
        }
    }

    fwrite(
        STDERR,
        'elavora/code-standards: erro: o autoloader do Composer não foi encontrado. '
        . "Rode \"composer install\" no projeto.\n",
    );

    exit(1);
})();
